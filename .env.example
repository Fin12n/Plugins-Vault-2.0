# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_ADMIN_ROLE_IDS=your_admin_role_ids_here
DISCORD_OWNER_ID=your_owner_discord_id_here
DISCORD_NOTIFY_CHANNEL_ID=your_notify_channel_id_here

# Server & Storage Configuration
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=false
VAULT_DIR=./vault
TMP_DIR=./tmp
DB_PATH=./data/vault.db
DASHBOARD_PASSWORD=change_this_to_a_secure_password
SESSION_SECRET=change_this_to_a_random_64_character_hex_string

# SePay Payment Gateway
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK_CODE=MB
SEPAY_CODE_PREFIX=VN
SEPAY_CODE_SUFFIX_LENGTH=10

# Card2k Payment Gateway (The cao)
CARD2K_BASE_URL=https://sandbox.card2k.com
CARD2K_PARTNER_ID=your_partner_id
CARD2K_PARTNER_KEY=your_partner_key
CARD2K_SIGN_FIELDS=partner_key,code,serial
CARD2K_COMMAND_CHARGE=charging
CARD2K_COMMAND_CHECK=check
CARD2K_TIMEOUT_MS=20000

# Orders & Upload Limits
ORDER_TTL_MINUTES=15
DOWNLOAD_TOKEN_TTL_MINUTES=15
PRUNE_KEEP_COUNT=10
ATTACH_MAX_BYTES=8388608
UPLOAD_MAX_FILE_BYTES=314572800
UPLOAD_MAX_FILES=50

# Spigot & Puppeteer Crawler Configuration
SPIGOT_CREDENTIALS_FILE=./data/spigot-credentials.json
SPIGOT_ACCOUNTS_FILE=./data/spigot-accounts.json
SPIGOT_DOWNLOAD_MIN_INTERVAL_MS=20000
SPIGOT_MAX_DOWNLOADS_PER_SWEEP=25
SPIGOT_BACKLOG_RESWEEP_MS=300000
SPIGOT_INTERACTIVE_CHALLENGE=false
SPIGOT_CHALLENGE_COOLDOWN_MS=1800000
SPIGOT_PROXY_API_URL=
SPIGOT_PROXY_RENEW_URL=
CHROME_PROFILE_DIR=./data/chrome-profile
SPIGOT_PROXY_COOLDOWN_MS=31000
SPIGOT_PROXY_MAX_ATTEMPTS=3

# YesCaptcha Solver
YESCAPTCHA_BASE_URL=https://api.yescaptcha.com
YESCAPTCHA_TIMEOUT_MS=120000
YESCAPTCHA_MAX_SOLVES_PER_SWEEP=10

# Chrome Browser Flags
CHROME_SHOW_WINDOW=false
CHROME_ENABLE_GPU=false
CHROME_DISPLAY=:0
