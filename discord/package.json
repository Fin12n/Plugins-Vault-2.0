{
  "name": "plugin-vault-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:generate": "pnpm --filter @vault/db db:generate",
    "db:push": "pnpm --filter @vault/db db:push",
    "db:migrate": "pnpm --filter @vault/db db:migrate",
    "db:studio": "pnpm --filter @vault/db db:studio",
    "db:sync-sqlite": "tsx scripts/sync-sqlite-to-neon.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-sql-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "deploy-commands": "tsx scripts/deploy-commands.ts",
    "simulate-payment": "tsx scripts/simulate-sepay-payment.ts",
    "set-price": "tsx scripts/set-deposit-price.ts",
    "rescan-purchased": "tsx scripts/rescan-purchased.ts",
    "check-accounts": "tsx scripts/check-spigot-accounts.ts",
    "reset-spigot-state": "tsx scripts/reset-spigot-state.ts",
    "reset:all-data": "tsx scripts/reset-all-data.ts",
    "tidy-names": "tsx scripts/tidy-plugin-names.ts",
    "typecheck": "tsc --noEmit",
    "docs:web": "node scripts/build-docs-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dashboard:build": "npm --prefix dashboard run build",
    "spigot-login": "tsx scripts/spigot-login.ts",
    "spigot-refresh": "tsx scripts/spigot-refresh-cookies.ts",
    "spigot-fetch": "tsx scripts/spigot-fetch-and-upload.ts",
    "spigot-probe-purchased": "tsx scripts/spigot-probe-purchased.ts",
    "spigot-probe-download": "tsx scripts/probe-live-download.ts",
    "spigot-probe-captcha": "tsx scripts/yescaptcha-probe.ts",
    "accounts-to-json": "tsx scripts/spigot-accounts-to-json.ts",
    "download-worker": "tsx scripts/download-worker.ts",
    "dashboard-only": "tsx scripts/dashboard-only.ts",
    "test:cloak": "tsx scripts/test-cloak-browser.ts",
    "setup:linux": "bash scripts/setup-linux.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@napi-rs/canvas": "^1.0.9",
    "@neondatabase/serverless": "^0.10.4",
    "@vault/db": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "cloakbrowser": "^0.5.10",
    "content-disposition": "^1.0.0",
    "discord.js": "^14.24.1",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.11.2",
    "fastify-raw-body": "^5.0.0",
    "lucide": "^1.48.0",
    "node-stream-zip": "^1.16.0",
    "puppeteer-core": "^25.11.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/content-disposition": "^0.5.9",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
